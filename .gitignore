# Personal documents - never commit these to a public repo
*.pdf
!docs/**/*.pdf

# Generated data
# NOTE: data/state.json is deliberately NOT ignored. It holds the job-ID hashes
# that stop the same posting being emailed twice, and must survive between CI
# runs. It contains no personal data.
data/jobs.json
data/profile.json
data/gap_report.json
data/email_preview.html
data/email_preview.json
data/drafts/

# Contains your phone number and email - keep it out of the public repo
data/answer_bank.json

# Generated by setup_task.ps1; embeds your email address
scripts/run_daily.ps1

# Base64 of the resume, produced for pasting into the RESUME_B64 secret
resume_b64.txt
resume_text.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
